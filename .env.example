PORT=3000
NODE_ENV=development

# Firebase Web App config (Firebase Console > Project settings > Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin service account JSON in one line.
# Render: add this as a secret environment variable. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Emails allowed to receive the first admin role on first login.
# Separate multiple addresses with commas.
ADMIN_EMAILS=seu-email@exemplo.com
