<%- include('partials/head') %>
<div class="layout">
  <aside class="sidebar">
    <a class="brand" href="/"><span class="brand-mark">H</span><span>HelpDesk<strong>TI</strong></span></a>
    <nav>
      <a href="/" data-nav="dashboard">Dashboard</a>
      <a href="/chamados" data-nav="tickets">Chamados</a>
      <a href="/chamados/novo" data-nav="new-ticket">Novo chamado</a>
      <a href="/usuarios" data-nav="users" id="nav-users" hidden>Usuários</a>
    </nav>
    <button class="btn outline full" id="logout">Sair</button>
  </aside>
  <main class="content">
    <header class="topbar"><div><span class="muted">HelpDesk TI</span><h1><%= title %></h1></div><div id="profile-chip" class="profile-chip">Carregando...</div></header>
    <div id="app-message" class="notice" role="status"></div>
    <section id="dashboard-view" hidden>
      <div class="stats" id="stats"></div>
      <div class="panel"><div class="section-head"><h2>Chamados recentes</h2><a href="/chamados">Ver todos</a></div><div id="recent-tickets"></div></div>
    </section>
    <section id="tickets-view" hidden>
      <div class="section-head"><p class="muted">Lista de chamados disponíveis conforme seu perfil.</p><a class="btn primary" href="/chamados/novo">Abrir chamado</a></div>
      <div id="tickets-list"></div>
    </section>
    <section id="new-ticket-view" hidden>
      <form id="ticket-form" class="panel form-panel">
        <label>Título<input name="titulo" maxlength="150" required></label>
        <label>Descrição<textarea name="descricao" rows="6" required></textarea></label>
        <div class="two-cols">
          <label>Categoria<input name="categoria" maxlength="80" placeholder="Ex.: Hardware"></label>
          <label>Setor<input name="setor" maxlength="80"></label>
        </div>
        <label>Prioridade<select name="prioridade"><option>Baixa</option><option selected>Média</option><option>Alta</option><option>Crítica</option></select></label>
        <button class="btn primary" type="submit">Enviar chamado</button>
      </form>
    </section>
    <section id="ticket-detail-view" hidden><div id="ticket-detail"></div></section>
    <section id="users-view" hidden>
      <div class="panel"><h2>Gerenciamento de usuários</h2><p class="muted">Somente administradores podem alterar perfis.</p><div id="users-list"></div></div>
    </section>
  </main>
</div>
<script>window.APP_PAGE = <%- JSON.stringify(page) %>;</script>
<script type="module" src="/js/app.js"></script>
</body></html>