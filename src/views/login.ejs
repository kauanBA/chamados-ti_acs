<%- include('partials/head') %>
<main class="auth-wrap">
  <section class="panel auth-panel">
    <div class="brand"><span class="brand-mark">H</span><span>HelpDesk<strong>TI</strong></span></div>
    <h1>Acesse sua conta</h1>
    <p class="muted">Entre para abrir e acompanhar chamados de suporte.</p>
    <form id="login-form">
      <label id="name-field" hidden>Nome completo<input type="text" id="display-name" autocomplete="name" maxlength="100"></label>
      <label>E-mail<input type="email" id="email" required autocomplete="email"></label>
      <label>Senha<input type="password" id="password" required autocomplete="current-password" minlength="6"></label>
      <button class="btn primary full" type="submit">Entrar</button>
    </form>
    <div class="separator">ou</div>
    <button class="btn google full" id="google-login" type="button">Continuar com Google</button>
    <p class="muted center">Ainda não tem conta? <a href="#" id="show-register">Criar conta</a></p>
    <p class="notice" id="auth-message" role="alert"></p>
  </section>
</main>
<script type="module" src="/js/auth.js"></script>
</body></html>